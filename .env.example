# Puerto en el que escucha el servidor
PORT=3000

# Conexión a PostgreSQL (usuario, contraseña, host, puerto y nombre de la base)
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/bienestar_eventos

# Clave para firmar los tokens JWT.
# Genera una nueva con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia_esto_por_una_frase_larga_y_aleatoria_de_64_caracteres

# Duración de la sesión (formato: 30m, 8h, 7d)
JWT_EXPIRA_EN=8h

# Máximo de intentos de login por cada 15 minutos y por IP
LOGIN_LIMITE=30