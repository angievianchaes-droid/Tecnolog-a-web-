# ===== Variables para ejecutar SIN Docker (npm start) =====
PORT=3000
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/bienestar_eventos
JWT_SECRET=cambia_esto_por_una_frase_larga_y_aleatoria_de_64_caracteres
JWT_EXPIRA_EN=8h
LOGIN_LIMITE=30

# ===== Variables para ejecutar CON Docker (docker compose up) =====
# Base de datos del contenedor
POSTGRES_DB=bienestar_eventos
POSTGRES_USER=bienestar
POSTGRES_PASSWORD=cambia_esta_contraseña

# Contraseñas de los usuarios de ejemplo (obligatorias en Docker)
ADMIN_PASSWORD=cambia_esta_1
BIENESTAR_PASSWORD=cambia_esta_2
ESTUDIANTE_PASSWORD=cambia_esta_3

# OPCIONAL: usar una base remota (Neon) en lugar del contenedor "db".
# COMPOSE_DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Genera un JWT_SECRET con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
